---
import Social from "./Social.astro";

const currentYear = new Date().getFullYear();
---

<footer>
  <div class="social-links">
    <Social
      platform="Facebook"
      url="https://web.facebook.com/wilmergulcochia/"
    />
    <Social platform="Instagram" url="https://www.instagram.com/wigsdev/" />
    <Social platform="GitHub" url="https://github.com/wigsdev" />
    <Social platform="LinkedIn" url="https://www.linkedin.com/in/wigsdev/" />
  </div>

  <div class="footer-bottom">
    <p>Wilmer Gulcochia © {currentYear}</p>
  </div>
</footer>

<style>
  footer {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
  }
</style>
