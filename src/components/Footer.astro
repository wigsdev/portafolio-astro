---
import Social from "./Social.astro";

const currentYear = new Date().getFullYear();
---

<footer>
  <div class="social-links">
    <p class="social-label">Sígueme</p>
    <div class="social-icons">
      <Social
        platform="Facebook"
        url="https://web.facebook.com/wilmergulcochia/"
        iconSrc="/icons/social/facebook.svg"
      />
      <Social
        platform="Instagram"
        url="https://www.instagram.com/wigsdev/"
        iconSrc="/icons/social/instagram.svg"
      />
      <Social
        platform="GitHub"
        url="https://github.com/wigsdev"
        iconSrc="/icons/social/github.svg"
      />
      <Social
        platform="LinkedIn"
        url="https://www.linkedin.com/in/wigsdev/"
        iconSrc="/icons/social/linkedin.svg"
      />
    </div>
  </div>

  <div class="footer-bottom">
    <p>Wilmer Gulcochia © {currentYear}</p>
  </div>
</footer>

<style>
  footer {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1rem;
    border-block: 1px solid var(--color-border);
  }

  .social-label {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .social-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
  }
</style>
