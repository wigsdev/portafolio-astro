---
import { Image } from "astro:assets";

interface Props {
  nombre: string;
  descripcion: string;
  tecnologias: string[];
  imagen: ImageMetadata;
  imagenAlt: string;
  demoUrl?: string;
  demoUnavailableMessage?: string;
  githubUrl: string;
}

const {
  nombre,
  descripcion,
  tecnologias,
  imagen,
  imagenAlt,
  demoUrl,
  demoUnavailableMessage = "Demo no disponible",
  githubUrl,
} = Astro.props;

---

<article class="project-card">
  <Image
    class="project-preview"
    src={imagen}
    alt={imagenAlt}
    width={640}
    height={360}
  />

  <ul class="project-technologies" aria-label="Tecnologías utilizadas">
    {
      tecnologias.slice(0, 3).map((tecnologia) => (
        <li
          class="technology-chip"
        >
          {tecnologia}
        </li>
      ))
    }
  </ul>

  <h2>{nombre}</h2>

  <p class="project-description">{descripcion}</p>

  <div class="project-actions">
    {
      demoUrl ? (
        <a
          class="project-demo"
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Demo
        </a>
      ) : (
        <span class="project-demo unavailable" aria-disabled="true">
          {demoUnavailableMessage}
        </span>
      )
    }

    <a
      class="project-repository"
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-card h2 {
    margin: 0.5rem 0 0;
  }

  .project-description {
    margin: 0.5rem 0 0;
  }

  .project-preview {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    place-items: center;
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    background-color: var(--color-surface-muted);
    text-align: center;
  }

  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-technologies li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    background-color: var(--color-surface);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .project-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .project-actions a,
  .unavailable {
    display: inline-flex;
    min-height: 2.5rem;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 0.625rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .project-demo {
    color: #ffffff;
    background-color: var(--color-brand);
    text-decoration: none;
  }

  a.project-demo:hover {
    background-color: var(--color-brand-hover);
  }

  .project-actions a:focus-visible {
    outline: 2px solid var(--color-brand-hover);
    outline-offset: 3px;
  }

  .project-actions .project-repository {
    border: 1px solid #1f2328;
    color: #1f2328;
    background-color: #ffffff;
    text-decoration: none;
  }

  .project-actions .project-repository:hover {
    border-color: #1f2328;
    color: #1f2328;
    background-color: #f3f4f6;
  }

  .unavailable {
    color: var(--color-text-muted);
    background-color: var(--color-surface-muted);
    font-weight: 500;
  }

  @media (max-width: 22rem) {
    .project-actions a,
    .project-actions .unavailable {
      padding-inline: 0.625rem;
      font-size: 0.8125rem;
    }
  }
</style>
