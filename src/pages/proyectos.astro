---
const proyectos = [
    {
        nombre: "Pomodoro",
        descripcion: "Aplicación integral de gestión del tiempo.",
        imagen: "/pomodoro.jpg",
        alt: "imagen de pomodoro apuntando a 25 minutos",
    },
    {
        nombre: "Blog Tecnológico",
        descripcion: "Posts sobre Tecnología",
        imagen: "/blog.jpg",
        alt: "laptop mostrando en pantalla pagina de blog",
    },
    {
        nombre: "Conversor md-pdf",
        descripcion: "Aplicación para conversión de Markdown a PDF.",
        imagen: "/markdown-to-pdf.png",
        alt: "imagen de conversor de markdown a pdf",
    },
];
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Proyectos</title>
    </head>
    <body>
        <h1>Proyectos</h1>
        {
            proyectos.map((proyecto) => (
                <article>
                    <img src={proyecto.imagen} alt={proyecto.alt} width="200"/>
                    <h2>{proyecto.nombre}</h2>
                    <p>{proyecto.descripcion}</p>
                </article>
            ))
        }

        <nav>
            <a href="/">Inicio</a>
            <a href="/sobre-mi/">Sobre mí</a>
            <a href="/proyectos/">Proyectos</a>
            <a href="/contacto/">Contacto</a>
        </nav>
    </body>
</html>
