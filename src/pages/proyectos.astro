---
import "../styles/global.css";
import { Image } from "astro:assets";
import pomodoroImagen from "../assets/pomodoro.jpg";
import blogImagen from "../assets/blog.jpg";
import conversorImagen from "../assets/markdown-to-pdf.png";

const proyectos = [
    {
        nombre: "Pomodoro",
        descripcion: "Aplicación integral de gestión del tiempo.",
        imagen: pomodoroImagen,
        alt: "imagen de pomodoro apuntando a 25 minutos",
    },
    {
        nombre: "Blog Tecnológico",
        descripcion: "Posts sobre Tecnología",
        imagen: blogImagen,
        alt: "laptop mostrando en pantalla pagina de blog",
    },
    {
        nombre: "Conversor md-pdf",
        descripcion: "Aplicación para conversión de Markdown a PDF.",
        imagen: conversorImagen,
        alt: "imagen de conversor de markdown a pdf",
    },
];
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Proyectos</title>
    </head>
    <body>
        <header>
            <nav>
                <a href="/">Inicio</a>
                <a href="/sobre-mi/">Sobre mí</a>
                <a href="/proyectos/" aria-current="page">Proyectos</a>
                <a href="/contacto/">Contacto</a>
            </nav>
        </header>
        <main>
            <h1>Proyectos</h1>
            <div class="proyectos-grid">
                {
                    proyectos.map((proyecto) => (
                        <article>
                            <Image
                                src={proyecto.imagen}
                                alt={proyecto.alt}
                                loading="eager"
                            />
                            <h2>{proyecto.nombre}</h2>
                            <p>{proyecto.descripcion}</p>
                        </article>
                    ))
                }
            </div>
        </main>
    </body>
</html>
